<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header & Delivery Courier Identity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_clinical_blue"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBackDeliveryProfile"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="TRANSIT COURIER IDENTITY"
                            android:textColor="#BFDBFE"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Delivery Agent Profile"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnEditDeliveryProfileHeader"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit"
                        android:padding="8dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- Avatar & Core Identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        app:cardCornerRadius="44dp"
                        app:cardElevation="6dp"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="3dp"
                        app:cardBackgroundColor="#FEF3C7">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_scooter_delivery"
                            app:tint="#D97706"
                            android:contentDescription="Delivery Courier Avatar" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDeliveryProfileFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Rajesh Kumar"
                        android:textColor="@color/white"
                        android:textSize="21sp" />

                    <!-- Courier ID Pill Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/badge_bg"
                        android:backgroundTint="#26FFFFFF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/secondary_mint" />

                        <TextView
                            android:id="@+id/tvDeliveryProfileAgentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Courier ID: DEL402"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDeliveryRolePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Express Medical Courier • Priority Transit"
                        android:textColor="#BFDBFE"
                        android:textSize="12.5sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp">

                <!-- Shift Status Card with Switch -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivProfileShiftStatusIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/secondary_mint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/tvProfileShiftTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shift Status: Online"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/neutral_dark"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvProfileShiftSubtext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active for live prescription order assignments"
                                android:textColor="@color/neutral_muted"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchProfileDeliveryShift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Performance Metrics Grid (2x2 Cards) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Deliveries Completed -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp">

                            <TextView
                                android:id="@+id/tvMetricDeliveriesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="128"
                                android:fontFamily="sans-serif-black"
                                android:textSize="22sp"
                                android:textColor="@color/primary_clinical_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deliveries Completed"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- On-Time Rate -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="98.5%"
                                android:fontFamily="sans-serif-black"
                                android:textSize="22sp"
                                android:textColor="@color/secondary_mint" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="On-Time Delivery"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Courier Rating -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.9 ★"
                                android:fontFamily="sans-serif-black"
                                android:textSize="22sp"
                                android:textColor="#D97706" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agent Rating"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Total Transit Distance -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="342 km"
                                android:fontFamily="sans-serif-black"
                                android:textSize="22sp"
                                android:textColor="@color/neutral_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transit Logged"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Vehicle & Hub Assignment Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VEHICLE &amp; DISPATCH HUB DETAILS"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/neutral_muted"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="12dp" />

                        <!-- Vehicle Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_delivery"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvDeliveryVehicleInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Two-Wheeler (Hero Electric Optima) • KA-01-EQ-9872"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- License Number -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_receipt"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvDeliveryLicenseNo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Driving License: DL-KA-2022-991823 • Verified"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Dispatch Hub -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvDeliveryDispatchHub"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Apollo Hospital Metro Central Hub • Counter 4"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Contact & Dispatch Records Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="COURIER CONTACT INFORMATION"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_muted"
                                android:textSize="11sp"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/btnEditDeliveryContactAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/primary_clinical_blue"
                                android:textSize="13sp"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Phone -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvDeliveryPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="+91 98765 43214"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- Email -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvDeliveryEmail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="del402@pharmago.com"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- Dispatch Hotline -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_phone"
                                app:tint="#D97706" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Emergency Dispatch Hotline: +91 80 2558 1000"
                                android:textColor="@color/neutral_muted"
                                android:textSize="12.5sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Action Button: View Live Routing Map -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeliveryOpenMap"
                    style="@style/Widget.PharmaGo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open Live Routing Map 🗺️"
                    android:textAllCaps="false"
                    android:layout_marginBottom="10dp" />

                <!-- Action Button: View Orders Feed -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeliveryOpenDashboard"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Delivery Orders Queue 🛵"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp" />

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeliverySignOut"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="End Shift / Sign Out"
                    android:textColor="#DC2626"
                    app:strokeColor="#FCA5A5"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
