<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search Healthcare"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search verified medicines, pharmacies, and clinics"
            android:textSize="13sp"
            android:textColor="@color/neutral_muted"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Modern Outlined Search Bar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_outline"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_search"
                    android:contentDescription="Search"
                    app:tint="@color/primary_clinical_blue" />

                <EditText
                    android:id="@+id/etSearchPharmacy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search medicine, store, or active ingredient"
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:textColorHint="@color/neutral_muted"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    style="@style/Widget.PharmaGo.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Find"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Horizontal Filter ChipGroup -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:checkedChip="@id/chipAll">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPharmacies"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏪 Pharmacies &amp; Clinics"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/border_outline" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHospitals"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥 Hospitals"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/border_outline" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedicines"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💊 Medicines"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/border_outline" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:checked="true"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/border_outline" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInStock"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ In Stock Only"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/border_outline" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Results Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Healthcare Results"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:layout_marginBottom="12dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/primary_clinical_blue"
            android:layout_marginBottom="12dp" />

        <!-- Primary RecyclerView for Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Backward-compatibility container -->
        <LinearLayout
            android:id="@+id/pharmacyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>