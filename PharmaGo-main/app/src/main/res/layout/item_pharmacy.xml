<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_outline"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/secondary_container">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hospital"
                    app:tint="@color/secondary_mint"
                    android:contentDescription="Pharmacy icon" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvPharmacyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apollo Pharmacy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark" />

                <TextView
                    android:id="@+id/tvPharmacyAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 123 Healthcare Ave, Sector 4"
                    android:textSize="12sp"
                    android:textColor="@color/neutral_muted"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPharmacyPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 +91 98765 12345"
            android:textSize="13sp"
            android:textColor="@color/neutral_muted"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_outline"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPharmacyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open 24/7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/success_green"
                android:background="@drawable/badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewMedicines"
                style="@style/Widget.PharmaGo.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="View Medicines"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>