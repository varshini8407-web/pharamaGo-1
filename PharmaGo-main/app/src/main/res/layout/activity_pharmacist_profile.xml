<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header & Pharmacist Identity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_clinical_blue"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBackPharmacistProfile"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="CLINICAL STAFF IDENTITY"
                            android:textColor="#BFDBFE"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Pharmacist Profile"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnEditPharmacistProfileHeader"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit"
                        android:padding="8dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- Avatar & Core Identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        app:cardCornerRadius="44dp"
                        app:cardElevation="6dp"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="3dp"
                        app:cardBackgroundColor="#E0F2FE">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hospital"
                            app:tint="@color/primary_clinical_blue"
                            android:contentDescription="Pharmacist Avatar" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPharmacistFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Dr. Arvind Sharma"
                        android:textColor="@color/white"
                        android:textSize="21sp" />

                    <!-- Staff ID Pill Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/badge_bg"
                        android:backgroundTint="#26FFFFFF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/secondary_mint" />

                        <TextView
                            android:id="@+id/tvPharmacistStaffId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Staff ID: ITA1024"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPharmacistDesignation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Senior Clinical Pharmacist • Dispensing Head"
                        android:textColor="#BFDBFE"
                        android:textSize="12.5sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp">

                <!-- Live Counter Status Switch Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/secondary_mint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/tvCounterStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Counter Active (Online)"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/neutral_dark"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accepting QR takeaway pickups &amp; live orders"
                                android:textColor="@color/neutral_muted"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPharmacistStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3 Metric Performance Counters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Metric 1: Dispensed -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="6dp">

                            <TextView
                                android:id="@+id/tvMetricDispensedOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="148"
                                android:fontFamily="sans-serif-black"
                                android:textSize="20sp"
                                android:textColor="@color/primary_clinical_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dispensed"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 2: QR Takeaways -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="6dp">

                            <TextView
                                android:id="@+id/tvMetricTakeaways"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="52"
                                android:fontFamily="sans-serif-black"
                                android:textSize="20sp"
                                android:textColor="@color/secondary_mint" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QR Pickups"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 3: Accuracy -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_outline"
                        app:cardBackgroundColor="@color/card_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="99.8%"
                                android:fontFamily="sans-serif-black"
                                android:textSize="20sp"
                                android:textColor="#D97706" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accuracy"
                                android:textSize="11.5sp"
                                android:textColor="@color/neutral_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Pharmacy Branch & License Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PHARMACY &amp; BRANCH DETAILS"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/neutral_muted"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="12dp" />

                        <!-- Assigned Pharmacy -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_hospital"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvPharmacistBranchName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Apollo Hospital Metro Pharmacy (Ground Floor Counter B)"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- License No -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_receipt"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvPharmacistLicenseNo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Reg. License: KA-PH-2024-8891 • State Pharmacy Council"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Operating Shift -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_analytics"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Shift: Day Duty (08:00 AM – 08:00 PM)"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Contact & Staff Records Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="STAFF CONTACT INFORMATION"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_muted"
                                android:textSize="11sp"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/btnEditContactAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/primary_clinical_blue"
                                android:textSize="13sp"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Phone -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvPharmacistPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="+91 94441 23456"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- Email -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:id="@+id/tvPharmacistEmail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="pharmacist.ita1024@apollo.hospital"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/neutral_dark"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <!-- Campus Emergency Extension -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_medical_cross"
                                app:tint="@color/primary_clinical_blue" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Internal Campus Line: Ext 404 (Station B)"
                                android:textColor="@color/neutral_muted"
                                android:textSize="12.5sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Action Button: Open QR Scanner -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileOpenScanner"
                    style="@style/Widget.PharmaGo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open Takeaway QR Scanner 📱"
                    android:textAllCaps="false"
                    android:layout_marginBottom="10dp" />

                <!-- Action Button: View Orders Queue -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileOpenOrders"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Dispensing Queue 📋"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp" />

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPharmacistSignOut"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign Out / End Shift"
                    android:textColor="#DC2626"
                    app:strokeColor="#FCA5A5"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
