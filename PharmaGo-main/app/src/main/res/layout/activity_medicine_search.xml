<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medicine Catalog"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark" />

        <TextView
            android:id="@+id/tvPharmacyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Pharmacy"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_clinical_blue"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Outlined Search Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_outline"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_search"
                    android:contentDescription="Search"
                    app:tint="@color/neutral_muted" />

                <EditText
                    android:id="@+id/etSearchMedicine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search medicine name..."
                    android:textSize="14sp"
                    android:textColor="@color/neutral_dark"
                    android:textColorHint="@color/neutral_muted"
                    android:background="@color/transparent"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchMedicine"
                    style="@style/Widget.PharmaGo.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Search"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Medicines"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_clinical_blue"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/medicineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>