<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_outline"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Icon Category Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotificationIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_container">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="@color/primary_clinical_blue"
                android:contentDescription="Notification Icon" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNotificationTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Prescription Verified"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark" />

                <!-- Unread Blue Dot Indicator -->
                <View
                    android:id="@+id/viewUnreadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="@color/primary_clinical_blue"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvNotificationBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr. Mitchell verified Rx #8942. Ready for delivery from Apollo Pharmacy."
                android:textSize="12sp"
                android:textColor="@color/neutral_muted"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvNotificationTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10 mins ago"
                    android:textSize="11sp"
                    android:textColor="@color/neutral_muted" />

                <TextView
                    android:id="@+id/tvNotificationAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Details ›"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_clinical_blue" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
