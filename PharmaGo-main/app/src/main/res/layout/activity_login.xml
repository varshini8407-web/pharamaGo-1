<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Top Medical Brand Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_outline"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_medical_cross"
                android:contentDescription="PharmaGo Brand Logo" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PharmaGo"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_dark"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your health, delivered safely."
            android:textSize="14sp"
            android:textColor="@color/neutral_muted"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Form Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_outline"
            app:cardBackgroundColor="@color/card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to order medicines &amp; track prescriptions"
                    android:textSize="13sp"
                    android:textColor="@color/neutral_muted"
                    android:layout_marginBottom="20dp" />

                <!-- Username TextInputLayout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username or Patient ID"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary_clinical_blue"
                    app:startIconDrawable="@drawable/ic_nav_profile"
                    app:startIconTint="@color/primary_clinical_blue"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/neutral_dark"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password TextInputLayout with Toggle -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary_clinical_blue"
                    app:endIconMode="password_toggle"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/neutral_dark"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- High-Emphasis Full-Width Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.PharmaGo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textAllCaps="false" />

                <!-- Pharmacist Portal Direct Access Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPharmacistPortal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Staff Portal: Pharmacist (ITA1024) 🏥"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary_mint"
                    android:backgroundTint="@color/secondary_container"
                    app:cornerRadius="14dp" />

                <!-- Delivery Agent Portal Direct Access Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeliveryAgentPortal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Delivery Agent Portal (DEL402) 🛵"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_clinical_blue"
                    android:backgroundTint="@color/primary_container"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- New User & Server Status -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New patient? Create an account"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_clinical_blue"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvServerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_status_checking"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:textColor="@color/neutral_muted" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
