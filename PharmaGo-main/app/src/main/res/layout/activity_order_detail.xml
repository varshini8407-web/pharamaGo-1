<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarOrderDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/neutral_dark"
            app:title="Order Details"
            app:titleTextColor="@color/neutral_dark"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="40dp">

            <!-- Order Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvDetailOrderId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order #102"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:id="@+id/tvDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY FOR PICKUP"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_mint"
                            android:background="@drawable/badge_bg"
                            android:backgroundTint="@color/secondary_container"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailPharmacyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏪 Apollo Central Pharmacy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_clinical_blue"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailOrderType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Type: Takeaway (Pickup Counter) • Placed Today"
                        android:textSize="12.5sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement Part 1.4: Delivery OTP Highlighted Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeliveryDetailOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/primary_container"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/primary_clinical_blue"
                            android:contentDescription="OTP" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Secure Delivery Verification"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share this OTP with your delivery agent:"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailOtpCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[ 4 8 2 9 1 5 ]"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:textColor="@color/primary_clinical_blue"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Order Line Items Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Medicines Ordered"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/neutral_dark"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layoutDetailItemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_outline"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:id="@+id/tvDetailTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹120.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Requirement Part 1.4: Distinct Actions -->
            <!-- 1. "View Pickup QR" (Visible ONLY if order_type == 'TAKEAWAY' and status is READY_FOR_PICKUP) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailViewPickupQR"
                style="@style/Widget.PharmaGo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View Pickup QR Code 📱"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- Track Delivery Button (if delivery) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailTrackDelivery"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Track Delivery 🛵"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#108A46"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- 2. "View Invoice Receipt" (For all completed/approved orders) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailViewInvoiceReceipt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="View Invoice Receipt 📄"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_dark"
                app:strokeColor="@color/border_outline"
                app:strokeWidth="1.2dp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
