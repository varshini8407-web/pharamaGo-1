<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_outline"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Medicine Info & Stock Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMedicineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amoxicillin 500mg"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark" />

                <TextView
                    android:id="@+id/tvMedicineDosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capsule • Strip of 10"
                    android:textSize="12sp"
                    android:textColor="@color/neutral_muted"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Real-time Inventory Stock Badge -->
            <TextView
                android:id="@+id/tvMedicineStockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● In Stock: 45 units"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_mint"
                android:background="@drawable/badge_bg"
                android:backgroundTint="@color/secondary_container"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_outline"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Row: Price & Interactive Quantity Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Unit Price & Subtotal -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUnitPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹90.00 / unit"
                    android:textSize="12sp"
                    android:textColor="@color/neutral_muted" />

                <TextView
                    android:id="@+id/tvItemSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtotal: ₹180.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_clinical_blue"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Interactive Quantity Stepper (+/-) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_bg"
                android:backgroundTint="@color/background_surface"
                android:padding="3dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMinusQty"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/primary_clinical_blue"
                        android:contentDescription="Decrease quantity" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvRequestedQty"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark"
                    android:gravity="center" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPlusQty"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_outline"
                    app:cardBackgroundColor="@color/card_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/primary_clinical_blue"
                        android:contentDescription="Increase quantity" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
