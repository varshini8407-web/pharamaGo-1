<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Base.Theme.PharmaGo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_clinical_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#1E293B</item>
        <item name="colorOnPrimaryContainer">#93C5FD</item>

        <item name="colorSecondary">@color/secondary_mint</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface & Background -->
        <item name="android:colorBackground">#0F172A</item>
        <item name="colorSurface">#1E293B</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#334155</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorOutline">#334155</item>

        <!-- Error -->
        <item name="colorError">@color/danger_alert</item>
        <item name="colorOnError">@color/white</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1E293B</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>