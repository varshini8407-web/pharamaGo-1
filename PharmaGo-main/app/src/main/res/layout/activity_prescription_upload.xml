<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top App Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBackPrescription"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/neutral_dark"
                    android:contentDescription="Back" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant Rx Scanner"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI-powered medical prescription reader"
                    android:textSize="12sp"
                    android:textColor="@color/neutral_muted" />
            </LinearLayout>

        </LinearLayout>

        <!-- Standalone/Medicine Context Card (Visible if launched for a specific medicine) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_outline"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Prescription Request"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_clinical_blue" />

                <TextView
                    android:id="@+id/tvOrderDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Medicine: All Prescribed Items • Verified by AI OCR"
                    android:textSize="13sp"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scanner Viewfinder Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScannerViewfinder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#93C5FD"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <!-- Scanner Viewport HUD Box -->
                <RelativeLayout
                    android:id="@+id/layoutViewfinder"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#0A192F"
                    android:gravity="center">

                    <!-- Document / Rx Preview Image -->
                    <ImageView
                        android:id="@+id/ivScannedPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0.85"
                        android:contentDescription="Scanned Document Preview" />

                    <!-- Scanner Reticle Graphic / Guide -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_nav_prescription"
                            app:tint="@color/secondary_mint"
                            android:contentDescription="Prescription" />

                        <TextView
                            android:id="@+id/tvScannerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Align doctor's prescription inside frame"
                            android:textSize="12sp"
                            android:textColor="#E2E8F0"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- Scanning Laser Beam Indicator -->
                    <View
                        android:id="@+id/viewLaserLine"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/secondary_mint"
                        android:visibility="gone" />

                </RelativeLayout>

                <!-- Status message -->
                <TextView
                    android:id="@+id/tvPrescriptionMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select scanning method below to extract items"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_clinical_blue"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />

                <!-- Action Scanning Option Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">

                    <!-- Camera Scan Option -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanCamera"
                        style="@style/Widget.PharmaGo.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Camera Scan"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        android:layout_marginEnd="6dp" />

                    <!-- Gallery / File Upload Option -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadPrescription"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Choose File"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/primary_clinical_blue"
                        app:strokeColor="@color/primary_clinical_blue"
                        app:icon="@drawable/ic_upload_cloud"
                        app:iconTint="@color/primary_clinical_blue"
                        app:iconGravity="textStart"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- One-tap Instant Sample Scan -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanDemo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Try Sample Prescription Scan"
                    android:textColor="@color/secondary_mint"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Indicator for OCR Engine -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_clinical_blue"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- DETECTED ITEMS CONTAINER (Shows extracted medicines, doctor info, doses, prices) -->
        <LinearLayout
            android:id="@+id/layoutDetectedItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <!-- Physician Verification Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/secondary_mint"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/secondary_mint"
                        android:contentDescription="Verified" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Arvind Sharma, MBBS, MD"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apollo Clinic • Digital Rx #RX-8942 • Verified ✓"
                            android:textSize="11sp"
                            android:textColor="@color/secondary_mint"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected Items Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detected Medicines &amp; Dosages (4 Items)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_dark"
                android:layout_marginBottom="8dp" />

            <!-- Item 1: Amoxicillin 500mg -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1. Amoxicillin 500mg Capsules"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹85.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty: 1 Strip (10 Caps) • Dosage: 1 cap twice daily after food"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 2: Paracetamol 650mg -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2. Paracetamol 650mg (Dolo)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹32.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty: 1 Strip (15 Tabs) • Dosage: 1 tab SOS for fever/pain"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 3: Cetirizine 10mg -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3. Cetirizine 10mg Tablets"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹28.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty: 1 Strip (10 Tabs) • Dosage: 1 tab at bedtime"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 4: Pantoprazole 40mg -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/card_surface"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="4. Pantoprazole 40mg (Pan-40)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹55.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty: 1 Strip (10 Tabs) • Dosage: 1 tab morning before breakfast"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bill & Pharmacy Matching Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_outline"
                app:cardBackgroundColor="@color/primary_container"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Prescription Bill"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/neutral_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹200.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_clinical_blue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏥 In Stock at: Apollo Metro Pharmacy (0.8 km)"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_muted"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Primary Action Button: Proceed to Summary & Checkout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.PharmaGo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proceed to Summary &amp; Checkout"
            android:textAllCaps="false"
            android:enabled="true" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>